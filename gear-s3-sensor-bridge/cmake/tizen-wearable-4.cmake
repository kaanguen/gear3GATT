# Use with an installed, matching Wearable-4.0 SDK. Configuration invokes a
# compiler; do not run without the user's build authorization.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(SB_TIZEN_SDK "$ENV{SB_TIZEN_SDK}" CACHE PATH "Legacy Tizen SDK root")
if(NOT SB_TIZEN_SDK)
  message(FATAL_ERROR "Set SB_TIZEN_SDK to the legacy SDK root; see SETUP.md")
endif()
set(CMAKE_SYSROOT "${SB_TIZEN_SDK}/platforms/tizen-4.0/wearable/rootstraps/wearable-4.0-device.core")
if(NOT EXISTS "${CMAKE_SYSROOT}/usr/include/network/bluetooth.h")
  message(FATAL_ERROR "Missing Wearable 4.0 ARM rootstrap; run tools/check_sdk.py")
endif()
set(SB_TIZEN_CC "$ENV{SB_TIZEN_CC}" CACHE FILEPATH "SDK ARM C compiler")
if(NOT EXISTS "${SB_TIZEN_CC}")
  message(FATAL_ERROR "Set SB_TIZEN_CC to the SDK arm-linux-gnueabi-gcc")
endif()
set(CMAKE_C_COMPILER "${SB_TIZEN_CC}")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_C_FLAGS_INIT "-march=armv7-a -mfloat-abi=softfp -fPIE")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-pie")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${CMAKE_SYSROOT}")
set(ENV{PKG_CONFIG_LIBDIR} "${CMAKE_SYSROOT}/usr/lib/pkgconfig:${CMAKE_SYSROOT}/usr/share/pkgconfig")
set(ENV{PKG_CONFIG_PATH} "")
